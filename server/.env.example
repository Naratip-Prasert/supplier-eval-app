# PostgreSQL / Supabase connection string
# Supabase format:  postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Local format:     postgresql://postgres:password@localhost:5432/supplier_eval
DATABASE_URL=postgresql://postgres:Teetuch12345678!@db.snuryviphxcdxuuudavz.supabase.co:5432/postgres

