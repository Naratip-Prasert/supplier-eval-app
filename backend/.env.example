# PostgreSQL / Neon connection string
# Neon format:   postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# Local format:  postgresql://postgres:password@localhost:5432/supplier_eval
DATABASE_URL=postgresql://[YOUR-USER]:[YOUR-PASSWORD]@[YOUR-PROJECT].neon.tech/[YOUR-DB]?sslmode=require

# Set to "true" when connecting to Neon or any hosted PostgreSQL that requires SSL
DATABASE_SSL=true

# Express server port
PORT=5000

# Frontend origin (used for CORS — no trailing slash)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development

# Auth — JWT & Email (Resend.com)
JWT_SECRET=change-this-to-a-random-32-char-string
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Supplier Eval <onboarding@resend.dev>
