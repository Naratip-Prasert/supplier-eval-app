# PostgreSQL / Neon connection string
# Neon format:   postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# Local format:  postgresql://postgres:password@localhost:5432/supplier_eval
DATABASE_URL=postgresql://[YOUR-USER]:[YOUR-PASSWORD]@[YOUR-PROJECT].neon.tech/[YOUR-DB]?sslmode=require

# Set to "true" when connecting to Neon or any hosted PostgreSQL that requires SSL
DATABASE_SSL=true

# Express server port
PORT=5000

# Frontend origin (used for CORS — no trailing slash)
FRONTEND_URL=http://localhost:3000

NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-random-32-char-string

# Email — sent via SMTP through a real Microsoft 365/Outlook mailbox
# (nodemailer + Office 365 SMTP relay), so recipients aren't limited to a
# single "verified" test address the way an unconfigured Resend account is.
# SMTP_USER/SMTP_PASS are the mailbox's own login (an App Password if the
# account has MFA enabled) — if the tenant has legacy SMTP AUTH disabled
# (Microsoft's default since 2022), ask IT to re-enable it for this mailbox.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-account@bjc.co.th
SMTP_PASS=your-password-or-app-password
EMAIL_FROM=Supplier Eval <your-account@bjc.co.th>

# AI help widget (chat bubble shown after login) — get a free key from
# aistudio.google.com (Google account, no card required for the free tier).
# Leave unset and the widget shows a "not configured" message instead of
# erroring.
GEMINI_API_KEY=
