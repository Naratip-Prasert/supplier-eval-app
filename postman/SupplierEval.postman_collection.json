{
  "info": {
    "name": "Supplier Eval API",
    "description": "Local dev collection for the Supplier Evaluation backend (Express + PostgreSQL). Auth is a cookie set by POST /api/auth/login — Postman's cookie jar carries it automatically on later requests as long as you keep hitting the same baseUrl. All non-GET requests need an X-Requested-With header (CSRF guard) — a collection-level pre-request script adds it automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "identifier", "value": "ADMIN-001" },
    { "key": "password", "value": "" },
    { "key": "employeeId", "value": "ADMIN-001" },
    { "key": "vendorCode", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "supplierEvalToken", "value": "" },
    { "key": "targetEmployeeId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!['GET', 'HEAD', 'OPTIONS'].includes(pm.request.method)) {",
          "  pm.request.headers.upsert({ key: 'X-Requested-With', value: 'XMLHttpRequest' });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Sets the httpOnly auth cookie on success. Rate-limited to 10 attempts / 15 min per IP."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Verify Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{employeeId}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/verify-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-password"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List Employees",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/employees", "host": ["{{baseUrl}}"], "path": ["api", "employees"] } }
        },
        {
          "name": "My Profile",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/employees/me", "host": ["{{baseUrl}}"], "path": ["api", "employees", "me"] } }
        },
        {
          "name": "Update My Profile Picture",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"profilePicture\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/employees/me", "host": ["{{baseUrl}}"], "path": ["api", "employees", "me"] }
          }
        },
        {
          "name": "Get Employee By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/employees/{{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "employees", "{{employeeId}}"] }
          }
        },
        {
          "name": "Update Employee Role/Active (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"USER\",\n  \"isActive\": true\n}" },
            "url": { "raw": "{{baseUrl}}/api/employees/{{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "employees", "{{employeeId}}"] }
          },
          "description": "PARTIAL update — delete a field to leave it unchanged. role must be one of USER, GCP, ADMIN, SUPERVISOR (400 otherwise). Careful testing on your own logged-in account's employeeId — isActive:false locks that account out of future logins immediately."
        }
      ]
    },
    {
      "name": "Suppliers",
      "item": [
        {
          "name": "List Suppliers",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/suppliers", "host": ["{{baseUrl}}"], "path": ["api", "suppliers"] } }
        },
        {
          "name": "Validate Supplier",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/suppliers/validate?vendorCode={{vendorCode}}&supplierName=",
              "host": ["{{baseUrl}}"], "path": ["api", "suppliers", "validate"],
              "query": [{ "key": "vendorCode", "value": "{{vendorCode}}" }, { "key": "supplierName", "value": "" }]
            }
          }
        },
        {
          "name": "Create Supplier",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"vendorCode\": \"{{vendorCode}}\",\n  \"supplierName\": \"Test Supplier\",\n  \"productType\": \"Raw Material\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/suppliers", "host": ["{{baseUrl}}"], "path": ["api", "suppliers"] }
          }
        },
        {
          "name": "Get Supplier By VendorCode",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/suppliers/{{vendorCode}}", "host": ["{{baseUrl}}"], "path": ["api", "suppliers", "{{vendorCode}}"] }
          }
        },
        {
          "name": "Update Supplier",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"supplierName\": \"ชื่อซัพพลายเออร์ใหม่\",\n  \"productType\": \"goods\",\n  \"isActive\": true\n}" },
            "url": { "raw": "{{baseUrl}}/api/suppliers/{{vendorCode}}", "host": ["{{baseUrl}}"], "path": ["api", "suppliers", "{{vendorCode}}"] }
          },
          "description": "PARTIAL update — delete a field to leave it unchanged. supplierName must be non-empty if sent. productType must be 'goods', 'services', or 'both' (400 otherwise)."
        },
        {
          "name": "Check Supplier Permission",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/suppliers/{{vendorCode}}/permission?employeeId={{employeeId}}",
              "host": ["{{baseUrl}}"], "path": ["api", "suppliers", "{{vendorCode}}", "permission"],
              "query": [{ "key": "employeeId", "value": "{{employeeId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "Criteria",
      "item": [
        {
          "name": "Get Criteria Tree (Pre)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criteria?evalType=pre_eval",
              "host": ["{{baseUrl}}"], "path": ["api", "criteria"],
              "query": [{ "key": "evalType", "value": "pre_eval" }]
            },
            "description": "evalType decides pre vs post here (not track — track only matters for Function Module lookups, evalType=function or m1-m7)."
          }
        },
        {
          "name": "Get Criteria Tree (Post)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criteria?evalType=post_eval",
              "host": ["{{baseUrl}}"], "path": ["api", "criteria"],
              "query": [{ "key": "evalType", "value": "post_eval" }]
            }
          }
        },
        {
          "name": "Create Category (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nameTh\": \"ชื่อหัวข้อใหม่\",\n  \"totalWeight\": 10,\n  \"codePrefix\": \"PRE-CORE\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/criteria/categories", "host": ["{{baseUrl}}"], "path": ["api", "criteria", "categories"] }
          },
          "description": "nameTh is required (400 if empty). codePrefix is required unless type is 'function', and must be exactly 'PRE-CORE' or 'POST-CORE' — that's what auto-generates the code (e.g. PRE-CORE6) and triggers the 'insert right before ESG' placement logic. type/track only matter for Function Module creation (type:'function', track:'pre'|'post') — omit both for a normal category."
        },
        {
          "name": "Update Category (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nameTh\": \"ชื่อหัวข้อใหม่\",\n  \"totalWeight\": 10,\n  \"groupWeights\": null,\n  \"groupLabels\": null\n}" },
            "url": { "raw": "{{baseUrl}}/api/criteria/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "criteria", "categories", "{{categoryId}}"] }
          },
          "description": "PARTIAL update — only include the fields you actually want to change, delete the rest. nameTh must be non-empty if sent. groupWeights/groupLabels: use null to leave unchanged/clear, or a populated object like {\"1\":50,\"2\":50} — an empty {} is rejected with 400 (it used to silently wipe every ESG group)."
        },
        {
          "name": "Delete Category (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/criteria/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "criteria", "categories", "{{categoryId}}"] }
          }
        },
        {
          "name": "Create Item (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"code\": \"1.1\",\n  \"nameTh\": \"ชื่อเกณฑ์ใหม่\",\n  \"defaultWeight\": 5,\n  \"criteriaSet\": \"pre_eval\",\n  \"levels\": []\n}" },
            "url": { "raw": "{{baseUrl}}/api/criteria/items", "host": ["{{baseUrl}}"], "path": ["api", "criteria", "items"] }
          },
          "description": "categoryId/code/nameTh/criteriaSet are required (400 if any missing/empty). categoryId must point to an ACTIVE category (400 if the category is soft-deleted, 404 if it doesn't exist at all). criteriaSet is 'pre_eval' or 'post_eval'. code is NOT auto-generated by the API — you must type the full code yourself (e.g. '1.4' under a category whose existing items go up to '1.3'); the Admin UI's auto-suggest is frontend-only (nextItemCode() in weightMath.js), the endpoint itself just uses whatever you send. A code colliding with an existing row (active OR inactive/soft-deleted) is rejected with 409, not silently overwritten. levels is optional 1-5 level description text, [] is fine here (unlike levelValues on items — different field)."
        },
        {
          "name": "Update Item (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nameTh\": \"ชื่อเกณฑ์ใหม่\",\n  \"detailTh\": \"รายละเอียด\",\n  \"defaultWeight\": 5,\n  \"code\": \"1.1\",\n  \"levelValues\": null\n}" },
            "url": { "raw": "{{baseUrl}}/api/criteria/items/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["api", "criteria", "items", "{{itemId}}"] }
          },
          "description": "PARTIAL update — only include the fields you actually want to change, delete the rest. nameTh/code must be non-empty if sent. levelValues: use null for the default 1-5 scale, or a populated array like [1,3,5] — an empty [] is rejected with 400 (it used to silently break score math via Math.max(...[]) = -Infinity)."
        },
        {
          "name": "Update Item Levels (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"levels\": [],\n  \"levelValues\": []\n}" },
            "url": { "raw": "{{baseUrl}}/api/criteria/items/{{itemId}}/levels", "host": ["{{baseUrl}}"], "path": ["api", "criteria", "items", "{{itemId}}", "levels"] }
          }
        },
        {
          "name": "Delete Item (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/criteria/items/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["api", "criteria", "items", "{{itemId}}"] }
          }
        },
        {
          "name": "Reorder (Admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"order\": []\n}" },
            "url": { "raw": "{{baseUrl}}/api/criteria/reorder", "host": ["{{baseUrl}}"], "path": ["api", "criteria", "reorder"] }
          }
        },
        {
          "name": "Reseed From Constants (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sections\": [],\n  \"reset\": false\n}" },
            "url": { "raw": "{{baseUrl}}/api/criteria/seed", "host": ["{{baseUrl}}"], "path": ["api", "criteria", "seed"] }
          }
        }
      ]
    },
    {
      "name": "Evaluations",
      "item": [
        {
          "name": "Submit Evaluation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"vendorCode\": \"{{vendorCode}}\",\n  \"evalType\": \"\",\n  \"period\": \"\",\n  \"productType\": \"\",\n  \"scores\": {},\n  \"sessionId\": null,\n  \"moduleCode\": null,\n  \"customModuleItems\": null\n}" },
            "url": { "raw": "{{baseUrl}}/api/evaluations", "host": ["{{baseUrl}}"], "path": ["api", "evaluations"] }
          }
        },
        { "name": "List Evaluations", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/evaluations", "host": ["{{baseUrl}}"], "path": ["api", "evaluations"] } } },
        { "name": "List All (Admin)", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/evaluations/all", "host": ["{{baseUrl}}"], "path": ["api", "evaluations", "all"] } } },
        { "name": "My Evaluations", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/evaluations/my", "host": ["{{baseUrl}}"], "path": ["api", "evaluations", "my"] } } },
        { "name": "My Tasks", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/evaluations/my-tasks", "host": ["{{baseUrl}}"], "path": ["api", "evaluations", "my-tasks"] } } },
        { "name": "My Timeline", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/evaluations/my-timeline", "host": ["{{baseUrl}}"], "path": ["api", "evaluations", "my-timeline"] } } },
        {
          "name": "By Vendor",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/evaluations/by-vendor/{{vendorCode}}", "host": ["{{baseUrl}}"], "path": ["api", "evaluations", "by-vendor", "{{vendorCode}}"] } }
        },
        {
          "name": "Get Evaluation By Id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/evaluations/1", "host": ["{{baseUrl}}"], "path": ["api", "evaluations", "1"] } }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "List Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions?vendorCode=&status=",
              "host": ["{{baseUrl}}"], "path": ["api", "sessions"],
              "query": [{ "key": "vendorCode", "value": "" }, { "key": "status", "value": "" }]
            }
          }
        },
        {
          "name": "Get Session By Id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionId}}"] } }
        }
      ]
    },
    {
      "name": "Supervisor",
      "item": [
        { "name": "Review Queue", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/supervisor/queue", "host": ["{{baseUrl}}"], "path": ["api", "supervisor", "queue"] } } },
        { "name": "Review History", "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/supervisor/history", "host": ["{{baseUrl}}"], "path": ["api", "supervisor", "history"] } } },
        {
          "name": "Approve Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/supervisor/sessions/{{sessionId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "supervisor", "sessions", "{{sessionId}}", "approve"] }
          }
        },
        {
          "name": "Return Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/supervisor/sessions/{{sessionId}}/return", "host": ["{{baseUrl}}"], "path": ["api", "supervisor", "sessions", "{{sessionId}}", "return"] }
          }
        },
        {
          "name": "Update Review Notes",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/supervisor/reviews/{{reviewId}}/notes", "host": ["{{baseUrl}}"], "path": ["api", "supervisor", "reviews", "{{reviewId}}", "notes"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Upload Pre/Post Excel",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] },
            "url": { "raw": "{{baseUrl}}/api/admin/upload/pre-post", "host": ["{{baseUrl}}"], "path": ["api", "admin", "upload", "pre-post"] },
            "description": "Select an .xlsx file in the form-data 'file' field before sending."
          }
        },
        {
          "name": "Upload Periodic Excel",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }, { "key": "evalType", "value": "half_year", "type": "text" }] },
            "url": { "raw": "{{baseUrl}}/api/admin/upload/periodic", "host": ["{{baseUrl}}"], "path": ["api", "admin", "upload", "periodic"] },
            "description": "evalType is 'half_year' or 'yearly'. Select an .xlsx file in the form-data 'file' field before sending."
          }
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/tasks?status=&role=&vendorCode=",
              "host": ["{{baseUrl}}"], "path": ["api", "admin", "tasks"],
              "query": [{ "key": "status", "value": "" }, { "key": "role", "value": "" }, { "key": "vendorCode", "value": "" }]
            }
          }
        },
        {
          "name": "Remind Task",
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/tasks/{{taskId}}/remind", "host": ["{{baseUrl}}"], "path": ["api", "admin", "tasks", "{{taskId}}", "remind"] } }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"assignedName\": \"\",\n  \"assignedEmail\": \"\",\n  \"dueDate\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "tasks", "{{taskId}}"] }
          }
        },
        {
          "name": "Delete Session",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "sessions", "{{sessionId}}"] } }
        },
        {
          "name": "Remind All",
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/tasks/remind-all", "host": ["{{baseUrl}}"], "path": ["api", "admin", "tasks", "remind-all"] } }
        },
        {
          "name": "Bulk Delete Sessions",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sessionIds\": []\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/sessions/bulk-delete", "host": ["{{baseUrl}}"], "path": ["api", "admin", "sessions", "bulk-delete"] }
          }
        },
        {
          "name": "List Upload Batches",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/admin/batches", "host": ["{{baseUrl}}"], "path": ["api", "admin", "batches"] } }
        }
      ]
    },
    {
      "name": "Public Supplier Eval",
      "description": "Cross-evaluation #3 (database/CROSS_EVALUATION_SPEC.md) — supplier rates the User/Buyer who evaluated them, via a one-time emailed magic-link. NOT behind requireAuth (no login cookie needed) — the token itself is the credential. Rate-limited to 20/15min/IP, same as /login. supplierEvalToken comes from the supplier_eval_tokens row created when a supervisor approves a session (only fires if that supplier has contact_email set — not currently populated by any upload flow, so you'll likely need to grab a token directly from the DB to test this manually).",
      "item": [
        {
          "name": "Get Who/What To Rate",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/public/supplier-eval/{{supplierEvalToken}}", "host": ["{{baseUrl}}"], "path": ["api", "public", "supplier-eval", "{{supplierEvalToken}}"] },
            "description": "404 if token doesn't exist, 410 if already used or expired. Returns { supplierName, targets: [{role, employeeId, fullName}], criteria: [...] } — targets is whichever of USER/GCP have a 'saved' evaluation on that session."
          }
        },
        {
          "name": "Submit Ratings",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ratings\": [\n    {\n      \"targetEmployeeId\": \"{{targetEmployeeId}}\",\n      \"role\": \"USER\",\n      \"scores\": {\n        \"SVC1.1\": { \"score\": 5 },\n        \"SVC1.2\": { \"score\": 5 },\n        \"SVC1.3\": { \"score\": 5 },\n        \"SVC1.4\": { \"score\": 5 }\n      }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/public/supplier-eval/{{supplierEvalToken}}", "host": ["{{baseUrl}}"], "path": ["api", "public", "supplier-eval", "{{supplierEvalToken}}"] },
            "description": "ratings is an array — one entry per target (USER and/or GCP) returned by the GET above, so both can be rated in one call. role must be 'USER' or 'GCP'. Marks the token used — a second call returns 410. Duplicate target within an already-used-up token returns 409 (checked via ON CONFLICT + rowcount, not silently dropped)."
          }
        }
      ]
    },
    {
      "name": "Service Evaluations",
      "description": "Cross-evaluation #4 (database/CROSS_EVALUATION_SPEC.md) — the USER who evaluated a supplier also rates the Buyer (GCP) they worked with on that same session, once it's completed. Behind requireAuth, reuses the normal USER login (login as a USER-role employee first, e.g. EMP-005 / User@1234).",
      "item": [
        {
          "name": "Pending (Sessions I Can Rate My Buyer For)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/service-evaluations/pending", "host": ["{{baseUrl}}"], "path": ["api", "service-evaluations", "pending"] } }
        },
        {
          "name": "My Feedback (Ratings I've Received)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/service-evaluations/my-feedback", "host": ["{{baseUrl}}"], "path": ["api", "service-evaluations", "my-feedback"] } }
        },
        {
          "name": "Get Criteria",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/service-evaluations/criteria", "host": ["{{baseUrl}}"], "path": ["api", "service-evaluations", "criteria"] } }
        },
        {
          "name": "Submit Rating",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"targetEmployeeId\": \"{{targetEmployeeId}}\",\n  \"scores\": {\n    \"SVC1.1\": { \"score\": 5 },\n    \"SVC1.2\": { \"score\": 5 },\n    \"SVC1.3\": { \"score\": 5 },\n    \"SVC1.4\": { \"score\": 5 }\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/service-evaluations", "host": ["{{baseUrl}}"], "path": ["api", "service-evaluations"] },
            "description": "Server re-derives from the DB that the logged-in user really was this session's USER evaluator and targetEmployeeId really was its GCP evaluator — 400 if not. Duplicate submission returns 409 (checked via ON CONFLICT + rowcount)."
          }
        }
      ]
    }
  ]
}
